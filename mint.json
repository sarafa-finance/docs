    "url": "https://sarafa.io"
  },
  "anchors": [
    {
      "name": "Documentation",
      "icon": "book-open-cover",
      "url": "https://docs.sarafa.io/"
    },
    {
      "name": "Facebook",
      "icon": "facebook",
      "url": "https://facebook.com/Sarafapay"
    },
    {
      "name": "Terms of Service",
      "icon": "newspaper",
      "url": "https://sarafa.io/tos"
    },
    {
      "name": "Privacy Policy",
      "icon": "newspaper",
      "url": "https://sarafa.io/privacy"
    }
