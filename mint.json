{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Sarafa Business API",
  "logo": {
    "dark": "/logo_white.png",
    "light": "/logo_white.png"
  },
  "favicon": "/logo_white.png",
  "theme": "prism",
  "layout": "topnav",
  "modeToggle": {
    "default": "light",
    "isHidden": true
  },
  "colors": {
    "primary": "#6c20f8",
    "light": "#07C983",
